<command>
  <exec>
    ps
    df
    ls
    getent
  </exec>
</command>

<command>
  <exec>
    uname 
  </exec>
  <arg>
    -n
  </arg>
</command>

<command>
  <exec>
    dspmq
    dspmqver
    ffstsummary
  </exec>
</command>

<command>
  <exec>
    runmqakm
  </exec>
  <arg>
    -cert\s+-list
    -cert\s+-details
  </arg>
</command>

<command>
  <exec>
    systemctl 
  </exec>
  <arg>
    --user\s+status 
  </arg>
</command>

<command>
  <exec>
    journalctl
  </exec>
</command>

<command>
  <exec>
    keysetter 
  </exec>
  <arg>
    add
    overwrite
  </arg>
</command>

