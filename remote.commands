<command>
  <exec>
    df
    dspmqcert
    getent
    du
    id
    last
    ls
    ps
    rpm
    uname 
    uptime
    who
  </exec>
</command>

<command>
  <exec>
    crontab 
  </exec>
  <arg>
    -l
  </arg>
</command>

<command>
  <exec>
    ffstsummary
    dspmq
    dspmqver
    mqconfig 
    chkconfig.ksh
  </exec>
</command>

<command>
  <exec>
    runmqakm
  </exec>
  <arg>
    -cert\s+-list
    -cert\s+-details
  </arg>
</command>

<command>
  <exec>
    systemctl 
  </exec>
  <arg>
    --user\s+status 
    --user\s+is-active
  </arg>
</command>

<command>
  <exec>
    journalctl
  </exec>
</command>

<command>
  <exec>
    keysetter 
  </exec>
  <arg>
    add
    overwrite
  </arg>
</command>

<command>
  <exec>
    awk
    cat
    egrep
    grep
    less
  </exec>
  <arg>
    \/etc\/[^\/]+
    ~/etc/.+
  </arg>
</command>

<command>
  <exec>
    /home/mqm/transfer/mqinstaller
  </exec>
</command>
