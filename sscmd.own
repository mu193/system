#     foreach my $arg (@{$_rules->{$id}{ARG}})
#     {
#       print "\t\t$arg\n";
#     }
#   }
# }

# print "$cmd\n" ;
# foreach my $arg (@arg)
# {
#   print "\t$arg\n" ;
# }

my $rc = checkCommand $_rules, $cmd, @arg ;

unless( $rc == 2 ) 
{
  die "not allowed to execute\n" ;
}

foreach my $line (`$orgCmd`)
{
  print "$line" ;
}

